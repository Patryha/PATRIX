# Wzór sekretów dla infra/docker-compose.yml. Nie commituj prawdziwego pliku .env.
SHOP_DOMAIN=sklep.example.pl
API_DOMAIN=api.example.pl
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=
PATRIX_ENCRYPTION_KEY=
ADMIN_MFA_ENFORCEMENT=required
STORE_CORS=https://sklep.example.pl
ADMIN_CORS=https://api.example.pl
AUTH_CORS=https://api.example.pl,https://sklep.example.pl
MEDUSA_BACKEND_URL=https://api.example.pl
# Zdjęcia produktów: domyślnie na dysku serwera (wolumen uploads, D-042). Zewnętrzny magazyn S3 (np. R2):
# odkomentuj i uzupełnij, wtedy pliki trafiają tam zamiast na dysk.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_ENDPOINT=
# S3_FILE_URL=
# S3_FORCE_PATH_STYLE=false
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://sklep.example.pl
PATRIX_ADMIN_URL=https://api.example.pl/app
# Hosty zdjęć dla optymalizatora obrazów sklepu (domena API, z której idą zdjęcia /static).
NEXT_PUBLIC_IMAGE_HOSTS=api.example.pl
NEXT_PUBLIC_ALLOW_INDEXING=false
