# PATRIX backend: przykładowa konfiguracja (bez sekretów). Skopiuj do .env i uzupełnij.
NODE_ENV=development
DATABASE_URL=postgres://postgres@localhost:5432/patrix_dev
REDIS_URL=redis://localhost:6379
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Sekrety: w produkcji wymagane, generuj np. `openssl rand -base64 48`
JWT_SECRET=
COOKIE_SECRET=
# Klucz szyfrujący sekrety MFA (natywne MFA Medusy)
AUTH_MFA_ENCRYPTION_KEY=
# 32 bajty w base64 (`openssl rand -base64 32`): szyfrowanie kluczy API integracji
PATRIX_ENCRYPTION_KEY=

# MFA pracowników: optional | required (zalecane w produkcji: required)
ADMIN_MFA_ENFORCEMENT=optional
JWT_EXPIRES_IN=8h

# Pliki (S3-compatible, np. MinIO, Cloudflare R2, AWS S3). Puste = pliki lokalne (tylko dev).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# shared | server | worker (w produkcji: osobny proces worker)
MEDUSA_WORKER_MODE=shared

# Wyłącza wysyłanie anonimowej telemetrii Medusy
MEDUSA_DISABLE_TELEMETRY=true
